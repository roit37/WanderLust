<%- layout("/layouts/boilerplate") %>

<div class="container py-5 my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="error-illustration mb-4">
                <i class="fa-solid fa-triangle-exclamation text-danger display-1"></i>
            </div>
            <h1 class="display-5 fw-bold mb-3"><%= statusCode === 404 ? "Page Not Found" : "Something Went Wrong" %></h1>
            <p class="lead text-muted mb-4">
                <%= message || "We couldn't find the page or resource you were looking for." %>
            </p>

            <% if (typeof stack !== 'undefined' && stack) { %>
                <div class="text-start bg-light p-3 rounded mb-4 overflow-auto" style="max-height: 200px;">
                    <pre class="small text-danger mb-0"><code><%= stack %></code></pre>
                </div>
            <% } %>

            <div class="d-flex justify-content-center gap-3">
                <a href="/listings" class="btn btn-dark rounded-pill px-4 py-2">
                    <i class="fa-solid fa-compass me-2"></i> Explore Properties
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    <i class="fa-solid fa-arrow-left me-2"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
