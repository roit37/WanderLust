<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 pb-3 border-bottom mb-4">
                    <img src="<%= user.avatar && user.avatar.url ? user.avatar.url : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" alt="<%= user.name %>" class="rounded-circle shadow-sm" style="width: 70px; height: 70px; object-fit: cover;">
                    <div>
                        <h4 class="fw-bold mb-1"><%= user.name %></h4>
                        <div class="text-muted small">@<%= user.username %> • <span class="badge bg-light text-dark border text-capitalize"><%= user.role %></span></div>
                    </div>
                </div>

                <form action="/profile" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email Address</label>
                        <input type="email" class="form-control rounded-3 bg-light text-muted" value="<%= user.email %>" disabled>
                        <div class="form-text small">Email cannot be modified directly.</div>
                    </div>

                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold small">Full Name</label>
                        <input type="text" name="name" id="name" class="form-control rounded-3" value="<%= user.name %>" required minlength="2">
                    </div>

                    <div class="mb-3">
                        <label for="bio" class="form-label fw-semibold small">About You (Bio)</label>
                        <textarea name="bio" id="bio" rows="3" class="form-control rounded-3" placeholder="Tell hosts and guests a little about yourself..."><%= user.bio %></textarea>
                    </div>

                    <div class="mb-4">
                        <label for="role" class="form-label fw-semibold small">Account Role</label>
                        <select name="role" id="role" class="form-select rounded-3" <%= user.role === 'admin' ? 'disabled' : '' %>>
                            <option value="guest" <%= user.role === 'guest' ? 'selected' : '' %>>Guest (Traveler)</option>
                            <option value="host" <%= user.role === 'host' ? 'selected' : '' %>>Host (Property Owner)</option>
                            <% if (user.role === 'admin') { %>
                                <option value="admin" selected>Platform Administrator</option>
                            <% } %>
                        </select>
                        <% if (user.role === 'guest') { %>
                            <div class="form-text small text-danger">Select "Host" to publish and manage your own vacation properties.</div>
                        <% } %>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/dashboard/guest" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn brand-btn text-white rounded-pill px-5 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
