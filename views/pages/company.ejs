<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger fs-3">
                    <i class="fa-solid fa-building-columns"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-1">Company Details</h2>
                    <p class="text-muted mb-0">Legal and corporate information about WanderLust Global, Inc.</p>
                </div>
            </div>

            <hr class="mb-4">

            <!-- Company Overview Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold mb-3 text-dark">About WanderLust</h4>
                <p class="text-secondary lh-lg mb-0">
                    WanderLust is an online marketplace connecting discerning travelers with distinctive, handpicked vacation rentals, coastal villas, historic castles, and mountain cabins across the world. Our platform empowers local hosts to build hospitable hosting businesses while offering travelers verified and authentic stays.
                </p>
            </div>

            <!-- Corporate Registration & Address Details -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h5 class="fw-bold mb-3 text-dark">
                            <i class="fa-solid fa-id-card text-danger me-2"></i> Corporate Registration
                        </h5>
                        <ul class="list-unstyled text-secondary lh-lg mb-0">
                            <li><strong class="text-dark">Legal Entity:</strong> WanderLust Global Technologies Inc.</li>
                            <li><strong class="text-dark">Incorporation:</strong> 2024</li>
                            <li><strong class="text-dark">Platform Status:</strong> Active & Verified</li>
                            <li><strong class="text-dark">Jurisdiction:</strong> India & Global Operations</li>
                        </ul>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h5 class="fw-bold mb-3 text-dark">
                            <i class="fa-solid fa-location-dot text-danger me-2"></i> Registered Headquarters
                        </h5>
                        <address class="text-secondary lh-lg mb-0">
                            <strong>WanderLust Technologies Pvt. Ltd.</strong><br>
                            Level 5, Horizon Business Tower<br>
                            Outer Ring Road, Bellandur<br>
                            Bengaluru, Karnataka 560103, India
                        </address>
                    </div>
                </div>
            </div>

            <!-- Customer Care & Contact Information -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 text-dark">
                    <i class="fa-solid fa-headset text-danger me-2"></i> Contact & Support
                </h5>
                <div class="row g-3 text-secondary lh-lg">
                    <div class="col-12 col-md-6">
                        <p class="mb-1"><strong class="text-dark">General Inquiries:</strong> support@wanderlust.com</p>
                        <p class="mb-1"><strong class="text-dark">Host Partnerships:</strong> hosts@wanderlust.com</p>
                        <p class="mb-0"><strong class="text-dark">Media & Press:</strong> press@wanderlust.com</p>
                    </div>
                    <div class="col-12 col-md-6">
                        <p class="mb-1"><strong class="text-dark">Grievance Officer:</strong> grievance@wanderlust.com</p>
                        <p class="mb-1"><strong class="text-dark">Operating Hours:</strong> 24/7 Traveler Assistance</p>
                        <p class="mb-0"><strong class="text-dark">Response SLA:</strong> Within 24 Hours</p>
                    </div>
                </div>
            </div>

            <!-- Trust & Safety -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3 text-dark">
                    <i class="fa-solid fa-shield-halved text-danger me-2"></i> Trust & Security Commitments
                </h5>
                <p class="text-secondary lh-lg mb-0">
                    We enforce strict host identity checks, bank-grade encryption on session data, verified stay review safeguards, and automated double-booking prevention to guarantee transparent and secure experiences for every guest and host.
                </p>
            </div>
        </div>
    </div>
</div>
