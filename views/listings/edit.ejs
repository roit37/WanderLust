<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="bg-primary-subtle p-3 rounded-circle text-primary">
                        <i class="fa-solid fa-pen-to-square fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">Edit Listing</h3>
                        <p class="text-muted small mb-0">Update your property details, pricing, and amenities.</p>
                    </div>
                </div>

                <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Property Title <span class="text-danger">*</span></label>
                        <input name="listing[title]" id="title" value="<%= listing.title %>" type="text" class="form-control rounded-3" required minlength="3">
                        <div class="invalid-feedback">Please enter a valid title.</div>
                    </div>

                    <!-- Category & Price -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select name="listing[category]" id="category" class="form-select rounded-3" required>
                                <% const categories = ["Trending", "Beachfront", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Rooms", "Luxury"]; %>
                                <% for (let cat of categories) { %>
                                    <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="price" class="form-label fw-semibold">Nightly Price (&#8377;) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-3">&#8377;</span>
                                <input name="listing[price]" id="price" value="<%= listing.price %>" type="number" min="0" class="form-control rounded-end-3" required>
                                <div class="invalid-feedback">Please enter a valid price.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3" required minlength="10"><%= listing.description %></textarea>
                        <div class="invalid-feedback">Please enter a description (at least 10 characters).</div>
                    </div>

                    <!-- Current Image Preview & Update Options -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                        <h6 class="fw-bold mb-2">Current Property Image</h6>
                        <div class="mb-3">
                            <img src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" alt="<%= listing.title %>" class="rounded-3 shadow-sm" style="max-height: 150px; object-fit: cover;">
                        </div>

                        <div class="mb-2">
                            <label for="imageFile" class="form-label small text-muted">Upload Replacement Image File</label>
                            <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*">
                        </div>
                        <div class="text-center text-muted small my-1">— OR —</div>
                        <div>
                            <label for="imageUrl" class="form-label small text-muted">Replace with Web Image URL</label>
                            <input name="listing[image]" id="imageUrl" value="<%= listing.image && listing.image.url ? listing.image.url : '' %>" type="url" class="form-control">
                        </div>
                    </div>

                    <!-- Location & Country -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="location" class="form-label fw-semibold">City / Location <span class="text-danger">*</span></label>
                            <input name="listing[location]" id="location" value="<%= listing.location %>" type="text" class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please enter location.</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="country" class="form-label fw-semibold">Country <span class="text-danger">*</span></label>
                            <input name="listing[country]" id="country" value="<%= listing.country %>" type="text" class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please enter country.</div>
                        </div>
                    </div>

                    <!-- Capacity -->
                    <div class="row g-3 mb-4">
                        <div class="col-4">
                            <label for="maxGuests" class="form-label fw-semibold small">Max Guests</label>
                            <input name="listing[maxGuests]" id="maxGuests" type="number" min="1" value="<%= listing.maxGuests || 2 %>" class="form-control rounded-3">
                        </div>
                        <div class="col-4">
                            <label for="bedrooms" class="form-label fw-semibold small">Bedrooms</label>
                            <input name="listing[bedrooms]" id="bedrooms" type="number" min="1" value="<%= listing.bedrooms || 1 %>" class="form-control rounded-3">
                        </div>
                        <div class="col-4">
                            <label for="bathrooms" class="form-label fw-semibold small">Bathrooms</label>
                            <input name="listing[bathrooms]" id="bathrooms" type="number" min="1" value="<%= listing.bathrooms || 1 %>" class="form-control rounded-3">
                        </div>
                    </div>

                    <!-- Amenities -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Amenities Offered</label>
                        <div class="row g-2">
                            <% 
                            const allAmenities = ["Wifi", "Kitchen", "Free parking", "Air conditioning", "Dedicated workspace", "Pool", "TV", "Washer", "Patio or balcony", "Mountain view"];
                            const currentAmenities = listing.amenities || [];
                            %>
                            <% for (let a of allAmenities) { %>
                                <div class="col-6 col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="amenity_<%= a %>" <%= currentAmenities.includes(a) ? 'checked' : '' %>>
                                        <label class="form-check-label small" for="amenity_<%= a %>"><%= a %></label>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-3 justify-content-end pt-3 border-top">
                        <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-5 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
