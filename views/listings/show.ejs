<%- layout("/layouts/boilerplate") %>

<div class="container py-4">
    <!-- Header Section -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <h2 class="fw-bold mb-2"><%= listing.title %></h2>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 text-muted small mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">
                        <i class="fa-solid fa-star text-warning me-1"></i>
                        <%= listing.avgRating > 0 ? listing.avgRating.toFixed(1) : 'New' %>
                    </span>
                    <span>•</span>
                    <a href="#reviews" class="text-dark fw-semibold"><%= listing.totalReviews || 0 %> reviews</a>
                    <span>•</span>
                    <span><i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %></span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <% 
                        const isLikedOnShow = (typeof currentUser !== 'undefined' && currentUser && typeof isInWishlist !== 'undefined' && isInWishlist);
                    %>
                    <form action="/wishlist/toggle/<%= listing._id %>" method="POST" class="d-inline wishlist-form">
                        <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill d-flex align-items-center gap-1" aria-label="Save to wishlist">
                            <i class="<%= isLikedOnShow ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                            <span class="wishlist-btn-text"><%= isLikedOnShow ? 'Saved' : 'Save' %></span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Property Main Image -->
            <div class="show-image-wrapper rounded-4 overflow-hidden mb-4 shadow-sm position-relative">
                <img 
                    src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=1200&q=80' %>" 
                    alt="<%= listing.title %>"
                    class="w-100 show-property-image object-fit-cover"
                >
                <span class="badge bg-white text-dark position-absolute top-0 end-0 m-3 shadow-sm rounded-pill px-3 py-2 fw-semibold">
                    <i class="fa-solid fa-tag text-danger me-1"></i> <%= listing.category %>
                </span>
            </div>

            <!-- Main Content & Reservation Sidebar -->
            <div class="row g-5">
                <!-- Left Details Column -->
                <div class="col-12 col-lg-7">
                    <!-- Host Info Card -->
                    <div class="d-flex align-items-center justify-content-between pb-4 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1">Hosted by <%= listing.owner ? listing.owner.name : 'Superhost' %></h4>
                            <p class="text-muted small mb-0">
                                <%= listing.maxGuests || 2 %> guests • <%= listing.bedrooms || 1 %> bedroom • <%= listing.bathrooms || 1 %> bath
                            </p>
                        </div>
                        <img 
                            src="<%= listing.owner && listing.owner.avatar && listing.owner.avatar.url ? listing.owner.avatar.url : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>" 
                            alt="<%= listing.owner ? listing.owner.name : 'Host' %>" 
                            class="rounded-circle host-avatar shadow-sm"
                        >
                    </div>

                    <!-- Highlights -->
                    <div class="py-4 border-bottom">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <i class="fa-solid fa-award text-danger fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Experienced Host</h6>
                                <p class="text-muted small mb-0"><%= listing.owner ? listing.owner.name : 'Host' %> has great reviews from verified travelers.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <i class="fa-solid fa-location-dot text-danger fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Great Location</h6>
                                <p class="text-muted small mb-0">95% of recent guests gave the location a 5-star rating.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <i class="fa-solid fa-calendar-xmark text-danger fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Flexible Cancellation</h6>
                                <p class="text-muted small mb-0">Cancel up to 48 hours before check-in for a full refund.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="py-4 border-bottom">
                        <h5 class="fw-bold mb-3">About this space</h5>
                        <p class="text-secondary listing-description-text lh-lg">
                            <%= listing.description %>
                        </p>
                    </div>

                    <!-- Amenities -->
                    <div class="py-4 border-bottom">
                        <h5 class="fw-bold mb-3">What this place offers</h5>
                        <div class="row g-3">
                            <% if (listing.amenities && listing.amenities.length > 0) { %>
                                <% for (let amenity of listing.amenities) { %>
                                    <div class="col-6 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-check text-success"></i>
                                        <span><%= amenity %></span>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <div class="col-6 d-flex align-items-center gap-2"><i class="fa-solid fa-wifi"></i> Wifi</div>
                                <div class="col-6 d-flex align-items-center gap-2"><i class="fa-solid fa-kitchen-set"></i> Kitchen</div>
                                <div class="col-6 d-flex align-items-center gap-2"><i class="fa-solid fa-car"></i> Free parking</div>
                                <div class="col-6 d-flex align-items-center gap-2"><i class="fa-solid fa-snowflake"></i> Air conditioning</div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Owner Action Buttons -->
                    <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || (listing.owner && listing.owner._id.toString() === currentUser._id.toString()))) { %>
                        <div class="py-4 d-flex gap-3 align-items-center">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark rounded-pill px-4">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Property
                            </a>
                            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
                                <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                    <i class="fa-solid fa-trash me-1"></i> Delete Property
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>

                <!-- Right Sticky Booking Card -->
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-lg rounded-4 p-4 sticky-top booking-widget-card" style="top: 100px;">
                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <div>
                                <span class="fs-3 fw-bold">&#8377; <%= Number(listing.price).toLocaleString("en-IN") %></span>
                                <span class="text-muted">/ night</span>
                            </div>
                            <div class="small fw-semibold">
                                <i class="fa-solid fa-star text-warning"></i>
                                <%= listing.avgRating > 0 ? listing.avgRating.toFixed(1) : 'New' %> • 
                                <span class="text-muted"><%= listing.totalReviews || 0 %> reviews</span>
                            </div>
                        </div>

                        <!-- Booking Date Selection Form -->
                        <form action="/bookings/checkout/<%= listing._id %>" method="GET" id="bookingCalculatorForm">
                            <div class="border rounded-4 overflow-hidden mb-3">
                                <div class="row g-0">
                                    <div class="col-6 border-end p-2">
                                        <label class="form-label small fw-bold text-uppercase text-muted mb-1" style="font-size: 0.75rem;">Check-in</label>
                                        <input type="date" name="checkIn" id="widgetCheckIn" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold" required>
                                    </div>
                                    <div class="col-6 p-2">
                                        <label class="form-label small fw-bold text-uppercase text-muted mb-1" style="font-size: 0.75rem;">Checkout</label>
                                        <input type="date" name="checkOut" id="widgetCheckOut" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold" required>
                                    </div>
                                </div>
                                <div class="border-top p-2">
                                    <label class="form-label small fw-bold text-uppercase text-muted mb-1" style="font-size: 0.75rem;">Guests</label>
                                    <select name="guests" id="widgetGuests" class="form-select form-select-sm border-0 p-0 shadow-none fw-semibold">
                                        <% for (let g = 1; g <= (listing.maxGuests || 4); g++) { %>
                                            <option value="<%= g %>"><%= g %> <%= g === 1 ? 'guest' : 'guests' %></option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>

                            <button type="submit" class="btn brand-btn w-100 py-3 rounded-pill text-white fw-bold fs-6 mb-2">
                                Reserve Property
                            </button>
                            <p class="text-center text-muted small mb-3">You won't be charged yet</p>

                            <!-- Live Price Breakdown Preview -->
                            <div id="priceCalculationBox" class="border-top pt-3 d-none">
                                <div class="d-flex justify-content-between text-muted mb-2">
                                    <span id="nightlyRateLine">&#8377; <%= listing.price %> × 0 nights</span>
                                    <span id="accommodationTotal">&#8377; 0</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted mb-2">
                                    <span>Cleaning fee</span>
                                    <span>&#8377; 500</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted mb-2">
                                    <span>WanderLust service fee</span>
                                    <span id="serviceFeeTotal">&#8377; 0</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between fw-bold fs-5">
                                    <span>Total before taxes</span>
                                    <span id="grandTotal" class="text-danger">&#8377; 0</span>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="row mt-5 pt-4 border-top" id="reviews">
                <div class="col-12">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <i class="fa-solid fa-star text-warning fs-4"></i>
                        <h4 class="fw-bold mb-0">
                            <%= listing.avgRating > 0 ? listing.avgRating.toFixed(1) : 'No reviews yet' %> 
                            <% if (listing.totalReviews > 0) { %>
                                • <%= listing.totalReviews %> <%= listing.totalReviews === 1 ? 'review' : 'reviews' %>
                            <% } %>
                        </h4>
                    </div>

                    <!-- Leave a Review Form (If Signed In) -->
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <div class="card border-0 bg-light rounded-4 p-4 mb-5">
                            <h5 class="fw-bold mb-2">Leave a Review</h5>
                            <p class="text-muted small mb-3">Share your experience to help future guests.</p>

                            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Rating</label>
                                    <div class="star-rating-input d-flex gap-2 fs-4">
                                        <input type="radio" id="star5" name="review[rating]" value="5" required />
                                        <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                                        <input type="radio" id="star4" name="review[rating]" value="4" />
                                        <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                                        <input type="radio" id="star3" name="review[rating]" value="3" />
                                        <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                                        <input type="radio" id="star2" name="review[rating]" value="2" />
                                        <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                                        <input type="radio" id="star1" name="review[rating]" value="1" />
                                        <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="reviewComment" class="form-label fw-semibold small">Comments</label>
                                    <textarea name="review[comment]" id="reviewComment" rows="3" class="form-control rounded-4" placeholder="How was your stay? What did you like best?" required></textarea>
                                    <div class="invalid-feedback">Please write a comment for your review.</div>
                                </div>

                                <button type="submit" class="btn btn-dark rounded-pill px-4">Submit Review</button>
                            </form>
                        </div>
                    <% } else { %>
                        <div class="alert alert-light border rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center">
                            <span>Have you stayed here? Log in to leave a review.</span>
                            <a href="/login" class="btn btn-sm btn-outline-dark rounded-pill">Log in</a>
                        </div>
                    <% } %>

                    <!-- Reviews List Grid -->
                    <% if (listing.reviews && listing.reviews.length > 0) { %>
                        <div class="row row-cols-1 row-cols-md-2 g-4">
                            <% for (let rev of listing.reviews) { %>
                                <div class="col">
                                    <div class="review-card p-3 border rounded-4 h-100 bg-white">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <img 
                                                    src="<%= rev.author && rev.author.avatar && rev.author.avatar.url ? rev.author.avatar.url : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&q=80' %>" 
                                                    alt="<%= rev.author ? rev.author.name : 'Guest' %>" 
                                                    class="rounded-circle"
                                                    style="width: 40px; height: 40px; object-fit: cover;"
                                                >
                                                <div>
                                                    <div class="fw-bold small mb-0"><%= rev.author ? rev.author.name : 'Traveler' %></div>
                                                    <div class="text-muted" style="font-size: 0.75rem;"><%= new Date(rev.createdAt).toLocaleDateString("en-US", { month: "short", year: "numeric" }) %></div>
                                                </div>
                                            </div>

                                            <% if (rev.verifiedBooking) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                                    <i class="fa-solid fa-badge-check me-1"></i> Verified Stay
                                                </span>
                                            <% } %>
                                        </div>

                                        <!-- Rating Stars -->
                                        <div class="text-warning small mb-2">
                                            <% for (let s = 1; s <= 5; s++) { %>
                                                <i class="<%= s <= rev.rating ? 'fa-solid fa-star' : 'fa-regular fa-star' %>"></i>
                                            <% } %>
                                        </div>

                                        <p class="text-secondary small mb-2"><%= rev.comment %></p>

                                        <!-- Delete review button -->
                                        <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || (rev.author && rev.author._id.toString() === currentUser._id.toString()))) { %>
                                            <form action="/listings/<%= listing._id %>/reviews/<%= rev._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this review?');">
                                                <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0" style="font-size: 0.8rem;">
                                                    <i class="fa-regular fa-trash-can me-1"></i> Delete
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No reviews yet for this property. Be the first to review!</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Embedded listing price for client calculation
    window.LISTING_PRICE = <%= listing.price %>;
</script>
