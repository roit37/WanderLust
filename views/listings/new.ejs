<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="bg-danger-subtle p-3 rounded-circle text-danger">
                        <i class="fa-solid fa-house-chimney-medical fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">List your property on WanderLust</h3>
                        <p class="text-muted small mb-0">Fill in the details below to publish your property for travelers worldwide.</p>
                    </div>
                </div>

                <form action="/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Property Title <span class="text-danger">*</span></label>
                        <input name="listing[title]" id="title" placeholder="e.g. Stunning Oceanfront Villa with Private Infinity Pool" type="text" class="form-control rounded-3" required minlength="3" maxlength="120">
                        <div class="invalid-feedback">Please provide a catchy title (at least 3 characters).</div>
                    </div>

                    <!-- Category & Price -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select name="listing[category]" id="category" class="form-select rounded-3" required>
                                <option value="Trending">Trending</option>
                                <option value="Beachfront">Beachfront</option>
                                <option value="Iconic Cities">Iconic Cities</option>
                                <option value="Mountains">Mountains</option>
                                <option value="Castles">Castles</option>
                                <option value="Amazing Pools">Amazing Pools</option>
                                <option value="Camping">Camping</option>
                                <option value="Farms">Farms</option>
                                <option value="Arctic">Arctic</option>
                                <option value="Domes">Domes</option>
                                <option value="Rooms">Rooms</option>
                                <option value="Luxury">Luxury</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="price" class="form-label fw-semibold">Nightly Price (&#8377;) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-3">&#8377;</span>
                                <input name="listing[price]" id="price" placeholder="1500" type="number" min="0" class="form-control rounded-end-3" required>
                                <div class="invalid-feedback">Please enter a valid price per night.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3" placeholder="Describe the ambiance, view, unique qualities, and neighbourhood..." required minlength="10"></textarea>
                        <div class="invalid-feedback">Please enter a description (at least 10 characters).</div>
                    </div>

                    <!-- Images: File Upload & Direct URL -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                        <h6 class="fw-bold mb-2"><i class="fa-solid fa-image me-1 text-danger"></i> Property Image</h6>
                        <div class="mb-2">
                            <label for="imageFile" class="form-label small text-muted">Option A: Upload Image File</label>
                            <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*">
                        </div>
                        <div class="text-center text-muted small my-1">— OR —</div>
                        <div>
                            <label for="imageUrl" class="form-label small text-muted">Option B: Image Web URL</label>
                            <input name="listing[image]" id="imageUrl" placeholder="https://images.unsplash.com/photo-..." type="url" class="form-control">
                        </div>
                    </div>

                    <!-- Location & Country -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="location" class="form-label fw-semibold">City / Location <span class="text-danger">*</span></label>
                            <input name="listing[location]" id="location" placeholder="e.g. South Beach, Miami" type="text" class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please provide the city or area location.</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="country" class="form-label fw-semibold">Country <span class="text-danger">*</span></label>
                            <input name="listing[country]" id="country" placeholder="e.g. United States" type="text" class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please provide the country.</div>
                        </div>
                    </div>

                    <!-- Capacity -->
                    <div class="row g-3 mb-4">
                        <div class="col-4">
                            <label for="maxGuests" class="form-label fw-semibold small">Max Guests</label>
                            <input name="listing[maxGuests]" id="maxGuests" type="number" min="1" value="2" class="form-control rounded-3">
                        </div>
                        <div class="col-4">
                            <label for="bedrooms" class="form-label fw-semibold small">Bedrooms</label>
                            <input name="listing[bedrooms]" id="bedrooms" type="number" min="1" value="1" class="form-control rounded-3">
                        </div>
                        <div class="col-4">
                            <label for="bathrooms" class="form-label fw-semibold small">Bathrooms</label>
                            <input name="listing[bathrooms]" id="bathrooms" type="number" min="1" value="1" class="form-control rounded-3">
                        </div>
                    </div>

                    <!-- Amenities -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Amenities Offered</label>
                        <div class="row g-2">
                            <% const defaultAmenities = ["Wifi", "Kitchen", "Free parking", "Air conditioning", "Dedicated workspace", "Pool", "TV", "Washer", "Patio or balcony", "Mountain view"]; %>
                            <% for (let a of defaultAmenities) { %>
                                <div class="col-6 col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="amenity_<%= a %>" checked>
                                        <label class="form-check-label small" for="amenity_<%= a %>"><%= a %></label>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Submit & Cancel -->
                    <div class="d-flex gap-3 justify-content-end pt-3 border-top">
                        <a href="/listings" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn brand-btn text-white rounded-pill px-5 fw-bold">Publish Property</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
