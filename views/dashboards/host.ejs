<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Host Operations Dashboard</h2>
            <p class="text-muted small mb-0">Overview of your properties, earnings, and incoming guest reservations.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/bookings/host-reservations" class="btn btn-outline-dark rounded-pill px-3">
                <i class="fa-solid fa-calendar-check me-1"></i> Reservations (<%= totalReservations %>)
            </a>
            <a href="/listings/new" class="btn brand-btn text-white rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-plus me-1"></i> Add Property
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Total Properties</div>
                <h3 class="fw-bold mb-0 text-dark"><%= totalListings %></h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Total Bookings</div>
                <h3 class="fw-bold mb-0 text-primary"><%= totalReservations %></h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Active Trips</div>
                <h3 class="fw-bold mb-0 text-success"><%= activeReservations %></h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Host Net Payouts</div>
                <h3 class="fw-bold mb-0 text-danger">&#8377; <%= totalRevenue.toLocaleString("en-IN") %></h3>
            </div>
        </div>
    </div>

    <!-- Host Properties Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Your Listed Properties</h5>
            <span class="badge bg-light text-dark border rounded-pill px-3 py-2"><%= listings.length %> Properties</span>
        </div>

        <% if (listings && listings.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Listing</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Rating</th>
                            <th>Max Guests</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let l of listings) { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img 
                                            src="<%= l.image && l.image.url ? l.image.url : '' %>" 
                                            alt="<%= l.title %>" 
                                            class="rounded-3" 
                                            style="width: 50px; height: 40px; object-fit: cover;"
                                        >
                                        <div>
                                            <a href="/listings/<%= l._id %>" class="fw-bold text-dark text-decoration-none d-block text-truncate" style="max-width: 250px;">
                                                <%= l.title %>
                                            </a>
                                            <span class="small text-muted"><%= l.location %>, <%= l.country %></span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border"><%= l.category %></span></td>
                                <td><span class="fw-bold">&#8377; <%= l.price.toLocaleString("en-IN") %></span> / night</td>
                                <td>
                                    <i class="fa-solid fa-star text-warning me-1"></i>
                                    <span><%= l.avgRating > 0 ? l.avgRating.toFixed(1) : 'New' %> (<%= l.totalReviews || 0 %>)</span>
                                </td>
                                <td><%= l.maxGuests || 2 %> guests</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a href="/listings/<%= l._id %>" class="btn btn-sm btn-outline-dark rounded-pill">View</a>
                                        <a href="/listings/<%= l._id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill">Edit</a>
                                        <form action="/listings/<%= l._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this property?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fa-solid fa-house-chimney text-muted display-4 mb-3"></i>
                <h5>You have no listings yet</h5>
                <p class="text-muted mb-3">Become an active host by publishing your first property today.</p>
                <a href="/listings/new" class="btn brand-btn text-white rounded-pill px-4">Create listing</a>
            </div>
        <% } %>
    </div>
</div>
