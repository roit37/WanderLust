<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="fa-solid fa-shield-halved text-danger fs-3"></i>
                <h2 class="fw-bold mb-0">Platform Administration</h2>
            </div>
            <p class="text-muted small mb-0">System-wide monitoring, user permissions, property moderation, and reservation logs.</p>
        </div>
        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">Super Admin Mode</span>
    </div>

    <!-- Platform KPI Cards -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Registered Users</div>
                <h2 class="fw-bold mb-0 text-primary"><%= totalUsers %></h2>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Live Properties</div>
                <h2 class="fw-bold mb-0 text-dark"><%= totalListings %></h2>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Total Bookings</div>
                <h2 class="fw-bold mb-0 text-success"><%= totalBookings %></h2>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-semibold mb-1">Platform Volume</div>
                <h2 class="fw-bold mb-0 text-danger">&#8377; <%= platformVolume.toLocaleString("en-IN") %></h2>
            </div>
        </div>
    </div>

    <!-- Tabs for Users, Listings, Bookings -->
    <ul class="nav nav-pills mb-4" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button" role="tab">
                <i class="fa-solid fa-users me-1"></i> Users (<%= users.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="listings-tab" data-bs-toggle="pill" data-bs-target="#listings-pane" type="button" role="tab">
                <i class="fa-solid fa-house-chimney me-1"></i> Listings (<%= listings.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="bookings-tab" data-bs-toggle="pill" data-bs-target="#bookings-pane" type="button" role="tab">
                <i class="fa-solid fa-calendar-check me-1"></i> Bookings (<%= bookings.length %>)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabsContent">
        <!-- 1. Users Tab -->
        <div class="tab-pane fade show active" id="users-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let u of users) { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="<%= u.avatar && u.avatar.url ? u.avatar.url : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&q=80' %>" alt="<%= u.name %>" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;">
                                            <span class="fw-semibold"><%= u.name %></span>
                                        </div>
                                    </td>
                                    <td>@<%= u.username %></td>
                                    <td><%= u.email %></td>
                                    <td>
                                        <form action="/dashboard/admin/users/<%= u._id %>/role" method="POST" class="d-inline">
                                            <select name="role" class="form-select form-select-sm rounded-pill d-inline-block w-auto border" onchange="this.form.submit()">
                                                <option value="guest" <%= u.role === 'guest' ? 'selected' : '' %>>Guest</option>
                                                <option value="host" <%= u.role === 'host' ? 'selected' : '' %>>Host</option>
                                                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td class="small text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                                    <td class="text-end pe-4">
                                        <% if (currentUser && u._id.toString() !== currentUser._id.toString()) { %>
                                            <form action="/dashboard/admin/users/<%= u._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Permanently remove user <%= u.username %>?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                    <i class="fa-solid fa-user-xmark"></i> Delete
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted border">Current User</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. Listings Tab -->
        <div class="tab-pane fade" id="listings-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Property</th>
                                <th>Owner</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Rating</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let l of listings) { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="<%= l.image && l.image.url ? l.image.url : '' %>" alt="<%= l.title %>" class="rounded-3" style="width: 50px; height: 40px; object-fit: cover;">
                                            <div>
                                                <a href="/listings/<%= l._id %>" class="fw-bold text-dark text-decoration-none d-block text-truncate" style="max-width: 250px;">
                                                    <%= l.title %>
                                                </a>
                                                <span class="small text-muted"><%= l.location %>, <%= l.country %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold"><%= l.owner ? l.owner.name : 'Unknown' %></div>
                                        <div class="small text-muted"><%= l.owner ? l.owner.email : '' %></div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border"><%= l.category %></span></td>
                                    <td class="fw-bold">&#8377; <%= l.price.toLocaleString("en-IN") %></td>
                                    <td>
                                        <i class="fa-solid fa-star text-warning"></i> <%= l.avgRating > 0 ? l.avgRating.toFixed(1) : 'New' %>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a href="/listings/<%= l._id %>" class="btn btn-sm btn-outline-dark rounded-pill">View</a>
                                            <a href="/listings/<%= l._id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill">Edit</a>
                                            <form action="/dashboard/admin/listings/<%= l._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Permanently remove listing?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. Bookings Tab -->
        <div class="tab-pane fade" id="bookings-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Booking ID</th>
                                <th>Property</th>
                                <th>Guest</th>
                                <th>Dates</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let b of bookings) { %>
                                <tr>
                                    <td class="ps-4 font-monospace small"><%= b._id.toString().slice(-8) %></td>
                                    <td><%= b.listing ? b.listing.title : 'Deleted Property' %></td>
                                    <td>
                                        <div class="fw-semibold"><%= b.user ? b.user.name : 'Guest' %></div>
                                        <div class="small text-muted"><%= b.user ? b.user.email : '' %></div>
                                    </td>
                                    <td class="small">
                                        <%= new Date(b.checkIn).toLocaleDateString() %> – <%= new Date(b.checkOut).toLocaleDateString() %>
                                    </td>
                                    <td class="fw-bold">&#8377; <%= b.totalPrice.toLocaleString("en-IN") %></td>
                                    <td>
                                        <span class="badge rounded-pill text-capitalize
                                            <%= b.status === 'confirmed' ? 'bg-success' : (b.status === 'completed' ? 'bg-primary' : 'bg-secondary') %>">
                                            <%= b.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
