<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row g-4">
        <!-- Profile Overview Card -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <img 
                    src="<%= user.avatar && user.avatar.url ? user.avatar.url : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80' %>" 
                    alt="<%= user.name %>" 
                    class="rounded-circle mx-auto mb-3 shadow-sm"
                    style="width: 110px; height: 110px; object-fit: cover;"
                >
                <h4 class="fw-bold mb-1"><%= user.name %></h4>
                <p class="text-muted small mb-2">@<%= user.username %></p>
                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 text-capitalize mb-3">
                    <i class="fa-solid fa-compass me-1"></i> <%= user.role %> Member
                </span>

                <p class="text-muted small mb-4 px-2"><%= user.bio %></p>

                <div class="d-grid gap-2">
                    <a href="/profile" class="btn btn-outline-dark rounded-pill btn-sm">Edit Profile</a>
                    <% if (user.role === 'guest') { %>
                        <form action="/profile" method="POST">
                            <input type="hidden" name="role" value="host">
                            <button type="submit" class="btn brand-btn text-white rounded-pill btn-sm w-100 fw-semibold">
                                <i class="fa-solid fa-house-chimney me-1"></i> Become a Host
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Dashboard Metrics & Trips -->
        <div class="col-12 col-md-8">
            <!-- Stat Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-sm-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                        <div class="text-muted small fw-semibold mb-1">Total Trips</div>
                        <h3 class="fw-bold mb-0 text-danger"><%= totalBookings %></h3>
                    </div>
                </div>
                <div class="col-6 col-sm-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                        <div class="text-muted small fw-semibold mb-1">Wishlist</div>
                        <h3 class="fw-bold mb-0 text-dark"><%= wishlistCount %></h3>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                        <div class="text-muted small fw-semibold mb-1">Upcoming</div>
                        <h3 class="fw-bold mb-0 text-success"><%= upcomingTrips.length %></h3>
                    </div>
                </div>
            </div>

            <!-- Upcoming Trips Section -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Upcoming Trips</h5>
                    <a href="/bookings/my-trips" class="small text-danger text-decoration-none fw-semibold">View all</a>
                </div>

                <% if (upcomingTrips && upcomingTrips.length > 0) { %>
                    <div class="list-group list-group-flush">
                        <% for (let trip of upcomingTrips) { %>
                            <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <img 
                                        src="<%= trip.listing && trip.listing.image && trip.listing.image.url ? trip.listing.image.url : '' %>" 
                                        alt="<%= trip.listing ? trip.listing.title : '' %>" 
                                        class="rounded-3" 
                                        style="width: 60px; height: 50px; object-fit: cover;"
                                    >
                                    <div>
                                        <div class="fw-bold text-truncate" style="max-width: 250px;"><%= trip.listing ? trip.listing.title : 'Trip' %></div>
                                        <div class="small text-muted">
                                            <%= new Date(trip.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %> – 
                                            <%= new Date(trip.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %>
                                        </div>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Confirmed</span>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-plane-departure display-6 mb-2 text-muted opacity-50"></i>
                        <p class="small mb-2">No upcoming trips on your calendar.</p>
                        <a href="/listings" class="btn btn-sm btn-dark rounded-pill">Explore stays</a>
                    </div>
                <% } %>
            </div>

            <!-- Quick Links -->
            <div class="row g-3">
                <div class="col-6">
                    <a href="/wishlist" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none text-dark h-100 hover-lift">
                        <i class="fa-solid fa-heart text-danger fs-4 mb-2"></i>
                        <div class="fw-bold">My Saved Wishlist</div>
                        <div class="small text-muted"><%= wishlistCount %> properties saved</div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/bookings/my-trips" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none text-dark h-100 hover-lift">
                        <i class="fa-solid fa-suitcase text-primary fs-4 mb-2"></i>
                        <div class="fw-bold">Past Trips & Receipts</div>
                        <div class="small text-muted">Review booking history</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
