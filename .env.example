# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/wanderlust
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wanderlust?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wanderlust

# Session Secret (Use a strong random string in production)
SESSION_SECRET=wanderlust_super_secret_session_key_2026_dev

# Cloudinary Storage Configuration (Optional - fallback to image URLs if not provided)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Configuration (Get Test Keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Default Admin Seed Credentials (used during database seeding)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@wanderlust.com
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin

# Default Demo Host & Guest Seed Credentials
HOST_EMAIL=host@wanderlust.com
HOST_PASSWORD=Host@123456
GUEST_EMAIL=guest@wanderlust.com
GUEST_PASSWORD=Guest@123456
